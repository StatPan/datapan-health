{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.dependency-observation.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generated_at", "scope", "operations"],
  "properties": {
    "schema_version": {"const": "datapan.dependency-observation.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "scope": {"$ref": "#/$defs/scope"},
    "operations": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/operation"}}
  },
  "$defs": {
    "scope": {"type": "object", "additionalProperties": false, "required": ["kind", "canary_count", "coverage"], "properties": {"kind": {"const": "external_dependency_observations"}, "canary_count": {"const": 10}, "coverage": {"const": "not_datapan_service_sla_or_catalog_coverage"}}},
    "operation": {"type": "object", "additionalProperties": false, "required": ["operation_id", "observation_state", "raw_observation_state", "incident_state", "consecutive_failure_threshold", "pending_count", "availability", "diagnosis"], "properties": {"operation_id": {"type": "string", "pattern": "^dpr-op-[0-9]{8}$"}, "observed_at": {"type": "string", "format": "date-time"}, "observation_state": {"enum": ["current", "stale", "not_observed"]}, "raw_observation_state": {"enum": ["succeeded", "failed", "unknown"]}, "incident_state": {"enum": ["operational", "pending", "confirmed", "recovering", "unknown"]}, "consecutive_failure_threshold": {"type": "integer", "minimum": 2, "maximum": 100}, "pending_count": {"type": "integer", "minimum": 0, "maximum": 99}, "availability": {"enum": ["operational", "degraded", "unknown"]}, "diagnosis": {"$ref": "#/$defs/diagnosis"}}, "allOf": [{"if": {"properties": {"observation_state": {"enum": ["stale", "not_observed"]}}}, "then": {"properties": {"raw_observation_state": {"const": "unknown"}, "incident_state": {"const": "unknown"}, "pending_count": {"const": 0}, "availability": {"const": "unknown"}}}}, {"if": {"properties": {"raw_observation_state": {"const": "succeeded"}}}, "then": {"properties": {"incident_state": {"enum": ["operational", "recovering"]}, "pending_count": {"const": 0}, "availability": {"const": "operational"}}}}, {"if": {"properties": {"raw_observation_state": {"const": "failed"}}}, "then": {"properties": {"incident_state": {"enum": ["pending", "confirmed"]}, "availability": {"const": "degraded"}}}}, {"if": {"properties": {"incident_state": {"const": "pending"}}}, "then": {"properties": {"pending_count": {"minimum": 1}}}}, {"if": {"properties": {"incident_state": {"enum": ["confirmed", "operational", "recovering", "unknown"]}}}, "then": {"properties": {"pending_count": {"const": 0}}}}]},
    "diagnosis": {"type": "object", "additionalProperties": false, "required": ["code", "determination", "accountable_party", "recommended_action_ids", "avoid_action_ids"], "properties": {"code": {"type": "string"}, "determination": {"enum": ["observed", "inferred", "unknown"]}, "accountable_party": {"enum": ["user", "datapan", "data_go_kr", "provider", "shared", "unknown"]}, "recommended_action_ids": {"type": "array", "maxItems": 8, "items": {"type": "string"}}, "avoid_action_ids": {"type": "array", "maxItems": 8, "items": {"type": "string"}}}}
  }
}
