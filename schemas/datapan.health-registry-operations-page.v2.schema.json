{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.health-registry-operations-page.v2.schema.json",
  "title": "Datapan Health bounded Registry operation page",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "read_model_generated_at", "registry_revision", "release_manifest_sha256", "index_sha256", "plan_schema_sha256", "page_schema_sha256", "metadata_registry_revision", "metadata_source_sha256", "metadata_catalog_sha256", "metadata_artifact_sha256", "metadata_api_entity_count", "metadata_operation_count", "identity_counts", "limit", "total_after_search", "operations"],
  "properties": {
    "schema_version": {"const": "datapan.health-registry-operations-page.v2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "read_model_generated_at": {"type": "string", "format": "date-time"},
    "registry_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "index_sha256": {"$ref": "#/$defs/sha256"},
    "plan_schema_sha256": {"$ref": "#/$defs/sha256"},
    "page_schema_sha256": {"$ref": "#/$defs/sha256"},
    "metadata_registry_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "metadata_source_sha256": {"$ref": "#/$defs/sha256"},
    "metadata_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "metadata_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "metadata_api_entity_count": {"type": "integer", "minimum": 0, "maximum": 20000},
    "metadata_operation_count": {"type": "integer", "minimum": 0, "maximum": 50000},
    "identity_counts": {"$ref": "#/$defs/counts"},
    "api_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "query": {"type": "string", "maxLength": 128},
    "limit": {"type": "integer", "minimum": 1, "maximum": 50},
    "total_after_search": {"type": "integer", "minimum": 0, "maximum": 100000},
    "next_cursor": {"type": "string", "maxLength": 1024},
    "operations": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/operation"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableDateTime": {"type": ["string", "null"], "format": "date-time"},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["known", "admitted", "claimed", "attempted", "persisted", "inventory_unknown_scopes", "inventory_unknown_operations", "acknowledged", "readback_verified", "delivery_pending", "missing", "late"],
      "properties": {
        "known": {"type": "integer", "minimum": 0, "maximum": 100000},
        "admitted": {"type": "integer", "minimum": 0, "maximum": 100000},
        "claimed": {"type": "integer", "minimum": 0, "maximum": 100000},
        "attempted": {"type": "integer", "minimum": 0, "maximum": 100000},
        "persisted": {"type": "integer", "minimum": 0, "maximum": 100000},
        "inventory_unknown_scopes": {"type": "integer", "minimum": 0, "maximum": 100000},
        "inventory_unknown_operations": {"type": "integer", "minimum": 0, "maximum": 100000},
        "acknowledged": {"type": "integer", "minimum": 0, "maximum": 100000},
        "readback_verified": {"type": "integer", "minimum": 0, "maximum": 100000},
        "delivery_pending": {"type": "integer", "minimum": 0, "maximum": 100000},
        "missing": {"type": "integer", "minimum": 0, "maximum": 100000},
        "late": {"type": "integer", "minimum": 0, "maximum": 100000}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "registry_operation_id", "api_id", "provider", "adapter_id", "protocol", "operation_name_state", "title_state", "organization_state", "purpose_state", "request_plan_state", "runtime_binding_state", "admission_state", "inventory_unknown", "observation_period_seconds", "next_due_at", "attempt_state", "observation_attempt_state", "request_started", "attempted", "observation_state", "provider_observed_at", "health_received_at", "gatus_delivery_state", "gatus_acknowledged_at", "gatus_readback_at"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "registry_operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "api_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "provider": {"type": "string", "maxLength": 128},
        "adapter_id": {"type": "string", "maxLength": 128},
        "protocol": {"enum": ["REST", "SOAP", "unknown"]},
        "operation_name": {"type": "string", "maxLength": 1024},
        "operation_name_state": {"enum": ["present", "missing", "blank", "invalid", "unsafe"]},
        "title": {"type": "string", "maxLength": 1024},
        "title_state": {"enum": ["present", "missing", "blank", "invalid", "unsafe"]},
        "organization": {"type": "string", "maxLength": 1024},
        "organization_state": {"enum": ["present", "missing", "blank", "invalid", "unsafe"]},
        "purpose": {"type": "string", "maxLength": 8192},
        "purpose_state": {"enum": ["present", "missing", "blank", "invalid", "unsafe"]},
        "request_plan_state": {"enum": ["complete", "incomplete", "unknown"]},
        "runtime_binding_state": {"enum": ["bound", "unbound", "unknown"]},
        "admission_state": {"enum": ["admitted", "not_admitted", "unknown"]},
        "inventory_unknown": {"type": "boolean"},
        "missing_reason": {"enum": ["inventory_unknown", "test_only", "request_plan_incomplete", "runtime_unbound", "not_admitted", "unsupported_contract", "no_validated_observation", "future_observation"]},
        "observation_period_seconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 31536000},
        "next_due_at": {"$ref": "#/$defs/nullableDateTime"},
        "attempt_state": {"enum": ["none", "claimed", "request_started", "observed", "failed", "unknown"]},
        "observation_attempt_state": {"enum": ["none", "observed"]},
        "request_started": {"type": ["boolean", "null"]},
        "attempted": {"type": "boolean"},
        "observation_state": {"enum": ["current_pass", "current_fail", "current_indeterminate", "stale", "unobserved"]},
        "result_state": {"enum": ["healthy", "unhealthy", "indeterminate"]},
        "result_category": {"enum": ["healthy", "transport_failure", "timeout", "rate_limited", "credential_missing", "credential_rejected", "parameter_blocked", "provider_failure", "semantic_failure", "schema_drift", "unsupported", "observer_failure", "indeterminate"]},
        "provider_observed_at": {"$ref": "#/$defs/nullableDateTime"},
        "health_received_at": {"$ref": "#/$defs/nullableDateTime"},
        "gatus_delivery_state": {"enum": ["not_ready", "pending", "acknowledged", "readback_verified"]},
        "gatus_acknowledged_at": {"$ref": "#/$defs/nullableDateTime"},
        "gatus_readback_at": {"$ref": "#/$defs/nullableDateTime"},
        "gatus_observed_state": {"enum": ["healthy", "unhealthy", "unknown"]}
      },
      "allOf": [
        {"if": {"required": ["result_state"], "properties": {"result_state": {"const": "healthy"}}}, "then": {"required": ["result_category"], "properties": {"result_category": {"const": "healthy"}}}},
        {"if": {"required": ["result_state"], "properties": {"result_state": {"const": "unhealthy"}}}, "then": {"required": ["result_category"], "properties": {"result_category": {"not": {"enum": ["healthy", "indeterminate", "observer_failure"]}}}}},
        {"if": {"required": ["result_state"], "properties": {"result_state": {"const": "indeterminate"}}}, "then": {"required": ["result_category"], "properties": {"result_category": {"enum": ["indeterminate", "observer_failure"]}}}},
        {"if": {"properties": {"observation_attempt_state": {"const": "none"}}}, "then": {"properties": {"result_state": {"not": {}}, "provider_observed_at": {"type": "null"}, "health_received_at": {"type": "null"}}}},
        {"if": {"properties": {"observation_attempt_state": {"const": "observed"}}}, "then": {"required": ["result_state"], "properties": {"provider_observed_at": {"type": "string", "format": "date-time"}, "health_received_at": {"type": "string", "format": "date-time"}}}},
        {"if": {"properties": {"attempt_state": {"const": "observed"}}}, "then": {"properties": {"observation_attempt_state": {"const": "observed"}}}},
        {"if": {"properties": {"observation_state": {"const": "current_pass"}}}, "then": {"required": ["result_state"], "properties": {"result_state": {"const": "healthy"}}}},
        {"if": {"properties": {"observation_state": {"const": "current_fail"}}}, "then": {"required": ["result_state"], "properties": {"result_state": {"const": "unhealthy"}}}},
        {"if": {"properties": {"observation_state": {"const": "current_indeterminate"}}}, "then": {"required": ["result_state"], "properties": {"result_state": {"const": "indeterminate"}}}}
      ]
    }
  }
}
