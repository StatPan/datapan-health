{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.health-self-readiness.v1.schema.json",
  "title": "Datapan Health private scheduler readiness",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ready", "state", "reason", "state_failures", "canaries", "public_readback", "deployment_identity"],
  "properties": {
    "schema_version": { "const": "datapan.health-self-readiness.v1" },
    "ready": { "type": "boolean" },
    "state": { "enum": ["ready", "startup", "degraded"] },
    "reason": { "$ref": "#/$defs/readiness_reason" },
    "last_loop": { "type": "string", "format": "date-time" },
    "state_failures": { "type": "integer", "minimum": 0 },
    "operation_plan": { "$ref": "#/$defs/operation_plan" },
    "canaries": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "state", "reason"],
        "properties": {
          "operation_id": { "type": "string", "pattern": "^dpr-op-[0-9]{8}$" },
          "last_started": { "type": "string", "format": "date-time" },
          "last_accepted": { "type": "string", "format": "date-time" },
          "last_delivered": { "type": "string", "format": "date-time" },
          "original_observed_at": { "type": "string", "format": "date-time" },
          "state": { "enum": ["ready", "startup", "degraded"] },
          "reason": { "$ref": "#/$defs/readiness_reason" }
        }
      }
    },
    "public_readback": { "const": "not_checked" },
    "deployment_identity": { "const": "not_checked" }
  },
  "allOf": [
    {
      "if": { "required": ["operation_plan"] },
      "then": { "properties": { "canaries": { "minItems": 0 } } },
      "else": { "properties": { "canaries": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "operation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "ready", "registry_revision", "release_manifest_sha256", "index_sha256",
        "activation_sha256", "canary_config_sha256", "identity_mapping_sha256", "runtime_pin_sha256",
        "known_operations", "admitted_operations", "capacity_feasible",
        "evidence_checked_operations", "evidence_current_operations",
        "evidence_missing_operations", "suppressed_legacy_canaries"
      ],
      "properties": {
        "schema_version": { "const": "datapan.health-operation-plan-readiness.v1" },
        "ready": { "type": "boolean" },
        "registry_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "release_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "index_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "activation_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "canary_config_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "identity_mapping_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "runtime_pin_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "known_operations": { "type": "integer", "minimum": 1 },
        "admitted_operations": { "type": "integer", "minimum": 0 },
        "capacity_feasible": { "type": "boolean" },
        "last_pass_at": { "type": "string", "format": "date-time" },
        "evidence_sweep_at": { "type": "string", "format": "date-time" },
        "evidence_checked_operations": { "type": "integer", "minimum": 0 },
        "evidence_current_operations": { "type": "integer", "minimum": 0 },
        "evidence_missing_operations": { "type": "integer", "minimum": 0 },
        "evidence_valid_until": { "type": "string", "format": "date-time" },
        "suppressed_legacy_canaries": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^dpr-op-[0-9]{8}$" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "ready": { "const": true } }, "required": ["ready"] },
          "then": { "required": ["last_pass_at", "evidence_sweep_at", "evidence_valid_until"] }
        }
      ]
    },
    "readiness_reason": {
      "enum": [
        "pipeline_current", "awaiting_first_delivery", "delivery_stale",
        "awaiting_first_loop", "scheduler_loop_stale", "scheduler_state_unavailable",
        "runtime_dependencies_unavailable", "delivery_failed", "cli_receipt_missing",
        "receipt_storage_unavailable", "receipt_unavailable", "scheduled_identity",
        "release_binding", "operation_identity", "catalog_identity", "registry_identity",
        "policy_identity", "policy_ceiling", "future_observation", "stale_observation",
        "receipt_contract", "delivered", "operation_plan_unavailable"
      ]
    }
  }
}
